<?xml version="1.0" encoding="utf-8"?>
<!--
  White is a tint base, not a colour choice: setBackgroundTintList multiplies
  against it, and setBackgroundColor cannot produce a rounded shape. The real
  fill is pushed by CashWidgetProvider from the tuner.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Larger than half the pill's own height in any launcher: Canvas clamps
      rx/ry to that half, so this always draws fully-rounded (stadium) ends. -->
    <corners android:radius="200dp" />
    <solid android:color="@android:color/white" />
</shape>
